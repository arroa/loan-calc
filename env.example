# ========================================
# SIMULADOR DE CRÉDITO CHILE - VARIABLES DE ENTORNO
# ========================================

# ========================================
# API KEYS
# ========================================

# API Key de Google Gemini (requerida para funcionalidades de IA)
GEMINI_API_KEY=your_gemini_api_key_here

# API Key de CMF (Comisión para el Mercado Financiero)
CMF_API_KEY=your_cmf_api_key_here

# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================

# Puerto del servidor backend
PORT=3001

# Puerto del servidor frontend (desarrollo)
VITE_PORT=5173

# Modo de ejecución (development, production, test)
NODE_ENV=development

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================

# URL de conexión a PostgreSQL (para futuras implementaciones)
DATABASE_URL=postgresql://username:password@localhost:5432/loan_simulator

# ========================================
# CONFIGURACIÓN DE APIS EXTERNAS
# ========================================

# API Key de CMF (Comisión para el Mercado Financiero) - REQUERIDA
CMF_API_KEY=your_cmf_api_key_here

# ========================================
# CONFIGURACIÓN DE SEGURIDAD
# ========================================

# Clave secreta para JWT (para futuras implementaciones)
JWT_SECRET=your_jwt_secret_here

# Tiempo de expiración de tokens (en segundos)
JWT_EXPIRES_IN=86400

# ========================================
# CONFIGURACIÓN DE LOGGING
# ========================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Archivo de logs
LOG_FILE=logs/app.log

# ========================================
# CONFIGURACIÓN DE CACHE
# ========================================

# Tiempo de cache para datos financieros (en segundos)
CACHE_DURATION=3600

# ========================================
# CONFIGURACIÓN DE LÍMITES
# ========================================

# Límite máximo de préstamo (en pesos chilenos)
MAX_LOAN_AMOUNT=50000000

# Límite mínimo de préstamo (en pesos chilenos)
MIN_LOAN_AMOUNT=500000

# Máximo número de cuotas
MAX_TERM=120

# Mínimo número de cuotas
MIN_TERM=6

# ========================================
# CONFIGURACIÓN DE TASAS
# ========================================

# Tasa mínima mensual (%)
MIN_MONTHLY_RATE=0.5

# Tasa máxima mensual (%)
MAX_MONTHLY_RATE=5.0

# ========================================
# CONFIGURACIÓN DE CORS
# ========================================

# Orígenes permitidos (separados por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ========================================
# CONFIGURACIÓN DE MONITOREO
# ========================================

# Habilitar métricas
ENABLE_METRICS=true

# URL de monitoreo (para futuras implementaciones)
MONITORING_URL=http://localhost:9090

# ========================================
# INSTRUCCIONES DE USO
# ========================================

# 1. Copia este archivo como .env.local
# 2. Completa las variables con tus valores reales
# 3. NUNCA subas el archivo .env.local al repositorio
# 4. Para producción, usa variables de entorno del servidor

# Variables requeridas para desarrollo:
# - GEMINI_API_KEY (para funcionalidades de IA)
# - PORT (puerto del servidor)

# Variables opcionales:
# - Todas las demás (tienen valores por defecto) 